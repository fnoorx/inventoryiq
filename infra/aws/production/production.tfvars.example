# Copy to production.auto.tfvars (ignored by Git) and fill in your values.
aws_account_id = "123456789012"
owner          = "your-name"
image_tag      = "deploy-YYYYMMDD-1"
bot_enabled    = false

# Optional non-secret settings passed to the bot as environment variables.
app_settings = {
  INVENTORY_CHANNEL_ID       = "000000000000000000"
  INVENTORY_DEFAULT_LOCATION = "DEMO"
}
