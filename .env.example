# Offline demo and tests need no .env file or external credentials.
# Set this explicitly only when connecting YOUR OWN accounts.
ENABLE_LIVE_INTEGRATIONS=false
DISCORD_TOKEN=
INVENTORY_CHANNEL_ID=
MARKET_CHANNEL_ID=
CATALOGUE_CHANNEL_ID=
BRAND_CATALOGUE_CHANNEL_ID=
LAUNCH_CHANNEL_ID=
STOCKX_SYNC_CHANNEL_ID=
INVENTORY_DEFAULT_LOCATION=DEMO
INVENTORY_DATABASE_PATH=data/inventoryiq.db
# Optional: use PostgreSQL instead of the SQLite file (see compose.yaml).
DATABASE_URL=
STOCKX_API_KEY=
STOCKX_ACCESS_TOKEN=
STOCKX_CLIENT_ID=
STOCKX_CLIENT_SECRET=
STOCKX_REFRESH_TOKEN=
STOCKX_SYNC_POLL_INTERVAL_MINUTES=180
SHEET_ID=
GOOGLE_CREDS_PROJECT_ID=
GOOGLE_CREDS_PRIVATE_KEY_ID=
GOOGLE_CREDS_PRIVATE_KEY=
GOOGLE_CREDS_CLIENT_EMAIL=
GOOGLE_CREDS_CLIENT_ID=
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
PERFORMANCE_METRICS_ENABLED=false
# Illustrative assumptions, not personal pricing or guaranteed payouts.
PURCHASE_DISCOUNT_PERCENT=0
PURCHASE_TAX_PERCENT=13

# AWS deployment only. The ECS task sets these; leave them unset locally.
# CREDENTIALS_BACKEND=aws
# AWS_REGION=ca-central-1
# APPLICATION_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:APPLICATION
# STOCKX_TOKEN_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:STOCKX
# DATABASE_SECRET_ARN=arn:aws:secretsmanager:REGION:ACCOUNT_ID:secret:DATABASE
# DATABASE_HOST=your-private-rds-endpoint
# DATABASE_NAME=inventoryiq
